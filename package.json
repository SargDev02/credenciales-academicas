{
  "name": "credenciales-academicas",
  "private": true,
  "description": "Monorepo de RAES, Credenly y conectores institucionales",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r --if-present test && node --test scripts/test/*.test.mjs",
    "test:frontend:browser": "playwright test",
    "test:academic-review:browser": "playwright test --config playwright.academic-review.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
