{
  "name": "@raes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @raes/contracts build",
    "dev": "next dev -p 3001",
    "prebuild": "pnpm --filter @raes/contracts build",
    "build": "next build",
    "start": "next start -p 3001",
    "pretypecheck": "pnpm --filter @raes/contracts build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "bootstrap:institution-a": "tsx scripts/bootstrap-institution-a.ts",
    "bootstrap:superadmin": "tsx scripts/bootstrap-superadmin.ts",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@raes/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5",
    "@raes/web-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
