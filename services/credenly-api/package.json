{
  "name": "@credenly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts scripts/lib/*.test.mjs",
    "admin:provision": "node --env-file=.env.local --env-file=../../apps/credenly-web/.env.local scripts/provision-credenly-admin.mjs",
    "citizen:reset-password": "node --env-file=.env.local scripts/reset-citizen-password.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5",
    "tesseract.js": "^7.0.0",
    "@raes/web-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
