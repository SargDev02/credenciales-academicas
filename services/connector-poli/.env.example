# Local development only. `start` forces APP_ENV=production and validates config.
APP_ENV=local
EXPOSURE_SCOPE=closed-synthetic-pilot
# Base académica del Politécnico (solo lectura para el conector)
POLI_SUPABASE_URL=https://project-ref.supabase.co
POLI_SUPABASE_SERVICE_ROLE_KEY=replace-locally

# API RAES
RAES_API_BASE_URL=http://localhost:3001
RAES_POLI_CLIENT_ID=replace-locally
RAES_POLI_CLIENT_SECRET=replace-locally

# Production: HTTPS origins, own service credentials only, explicit cohort.
# The ingress must overwrite the trusted client-IP header and block direct origin access.
