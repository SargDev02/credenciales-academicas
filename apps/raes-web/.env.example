# URL pública y publishable/anon del proyecto RAES; jamás service_role.
# Solo se usan en el servidor web. No se envían tokens al JavaScript del browser.
RAES_WEB_SUPABASE_URL=https://your-project.supabase.co
RAES_WEB_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
RAES_API_BASE_URL=http://localhost:3001

# Opcional: host/IP de desarrollo en LAN, separados por comas, sin protocolo ni puerto.
RAES_WEB_ALLOWED_DEV_ORIGINS=
