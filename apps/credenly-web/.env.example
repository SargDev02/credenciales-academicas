# Local development only. `start` forces APP_ENV=production and validates config.
APP_ENV=local
EXPOSURE_SCOPE=closed-synthetic-pilot
# URL pública y publishable/anon del proyecto Credenly; jamás service_role.
# Solo se usan en el servidor web. No se envían tokens al JavaScript del browser.
CREDENLY_WEB_SUPABASE_URL=https://your-project.supabase.co
CREDENLY_WEB_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
CREDENLY_API_BASE_URL=http://localhost:3002

# Origen público permitido para confirmación de correo Auth
CREDENLY_WEB_SITE_URL=http://localhost:3003

# Opcional: host/IP de desarrollo en LAN, separados por comas, sin protocolo ni puerto.
CREDENLY_WEB_ALLOWED_DEV_ORIGINS=

CREDENLY_ADMISSION_SECRET=

PILOT_ALLOWED_EMAILS=

TRUSTED_CLIENT_IP_HEADER=

# Production: HTTPS origins, own service credentials only, explicit cohort.
# The ingress must overwrite the trusted client-IP header and block direct origin access.
